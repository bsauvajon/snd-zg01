#!/bin/bash

# Install script for snd-zg01 DKMS module

set -e

NAME=snd-zg01
VERSION=1.0.0

case "$1" in
    configure)
        # Unload any currently running version of the module to avoid
        # stale ALSA cards surviving across an upgrade (old cards hold a
        # dangling card->module pointer once the old .ko is replaced).
        modprobe -r snd-zg01 2>/dev/null || true
        # Also remove old split-module names that may be loaded from a
        # previous installation.
        modprobe -r zg01_usb zg01_pcm zg01_control zg01_usb_discovery 2>/dev/null || true

        # Register with DKMS
        dkms add -m $NAME -v $VERSION || true
        dkms build -m $NAME -v $VERSION || true
        dkms install -m $NAME -v $VERSION || true
        
        # Install modules-load.d file so snd-zg01 is pre-loaded at boot
        # before snd-usb-audio claims the ZG01 via its generic wildcard alias.
        if [ -f /usr/src/$NAME-$VERSION/src/snd-zg01.conf ]; then
            cp /usr/src/$NAME-$VERSION/src/snd-zg01.conf /etc/modules-load.d/
        fi

        # Remove stale udev rule copies from older package versions; the
        # rule file is obsolete (dead card IDs, redundant modalias load).
        rm -f /etc/udev/rules.d/90-zg01.rules || true
        udevadm control --reload-rules 2>/dev/null || true

        echo "Yamaha ZG01 driver installed via DKMS"
        echo "The module has been built and installed for your kernel"
        echo ""
        echo "The driver will automatically load when you connect the ZG01."
        echo "If the device is already connected, unplug and reconnect it."
        echo ""
        echo "One ALSA card with three PCM devices:"
        echo "  - Game Out (hw:N,0, playback)"
        echo "  - Voice Out (hw:N,1, playback)"
        echo "  - Voice In (hw:N,2, capture)"
        echo ""
        echo "To manually load the driver, run:"
        echo "  sudo modprobe snd-zg01"
        echo ""
        echo "Check audio devices with:"
        echo "  cat /proc/asound/cards"
        ;;
esac

#DEBHELPER#

exit 0
