#!/bin/bash

# Remove script for snd-zg01 DKMS module

set -e

NAME=snd-zg01
VERSION=1.0.0

case "$1" in
    remove|upgrade|deconfigure)
        # Unload the module before removing so that ALSA cards are freed
        # cleanly and don't leave dangling card->module pointers.
        # Note: kernel module names use underscores, not dashes
        if lsmod | grep -q "^snd_zg01 "; then
            echo "Unloading snd_zg01 kernel module..."
            modprobe -r snd_zg01 2>/dev/null || rmmod snd_zg01 2>/dev/null || true
        fi

        # Only remove from DKMS on actual removal, not on upgrade
        if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
            # Uninstall from DKMS
            if dkms status -m $NAME -v $VERSION 2>/dev/null | grep -q "$NAME"; then
                echo "Removing $NAME/$VERSION from DKMS..."
                dkms remove -m $NAME -v $VERSION --all 2>/dev/null || true
            fi
        fi
        
        # Remove udev rules and modules-load config only on actual removal
        if [ "$1" = "remove" ]; then
            rm -f /etc/udev/rules.d/90-zg01.rules || true
            rm -f /etc/modules-load.d/snd-zg01.conf || true
            udevadm control --reload-rules 2>/dev/null || true
            udevadm trigger 2>/dev/null || true
            
            echo "Yamaha ZG01 driver removed"
        fi
        ;;
    purge)
        # Ensure module is unloaded
        if lsmod | grep -q "^snd_zg01 "; then
            modprobe -r snd_zg01 2>/dev/null || rmmod snd_zg01 2>/dev/null || true
        fi
        
        # Remove from DKMS if still present
        if dkms status -m $NAME -v $VERSION 2>/dev/null | grep -q "$NAME"; then
            echo "Removing $NAME/$VERSION from DKMS..."
            dkms remove -m $NAME -v $VERSION --all 2>/dev/null || true
        fi
        
        # Remove source directory on purge
        rm -rf /usr/src/$NAME-$VERSION || true
        
        # Remove udev rules and modules-load config
        rm -f /etc/udev/rules.d/90-zg01.rules || true
        rm -f /etc/modules-load.d/snd-zg01.conf || true
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger 2>/dev/null || true
        
        echo "Yamaha ZG01 driver purged"
        ;;
esac

#DEBHELPER#

exit 0
