# Maintainer: Yamaha ZG01 Driver Contributors

_pkgname=snd-zg01
pkgname=snd-zg01-dkms-git
pkgver=r68.3cf4c38
pkgrel=1
pkgdesc="Experimental Yamaha ZG01 USB audio driver (DKMS, git)"
arch=('any')
url="https://github.com/softashell/snd-zg01"
license=('GPL-2.0-or-later')
depends=('dkms')
makedepends=('git')
provides=('snd-zg01-dkms')
conflicts=('snd-zg01-dkms')
source=("${_pkgname}::git+${url}.git#branch=arch")
sha256sums=('SKIP')

pkgver() {
  cd "${_pkgname}"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
  local dkms_root="${pkgdir}/usr/src/${_pkgname}-${pkgver}"

  install -dm755 "${dkms_root}/src"
  install -m644 "${_pkgname}/Makefile" "${dkms_root}/Makefile"
  install -m644 "${_pkgname}/dkms.conf" "${dkms_root}/dkms.conf"
  install -m644 "${_pkgname}"/src/*.[ch] "${dkms_root}/src/"

  sed -i \
    -e "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"${pkgver}\"/" \
    -e '/^BUILT_MODULE_UDEV_RULES/d' \
    -e '/^CLEAN=/d' \
    -e 's|^MAKE\[0\]=.*|MAKE[0]="make LLVM=1 KDIR=/lib/modules/\\$kernelver/build"|' \
    "${dkms_root}/dkms.conf"

  install -Dm644 "${_pkgname}/src/90-zg01.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/90-zg01.rules"
  install -Dm644 "${_pkgname}/src/snd-zg01.conf" \
    "${pkgdir}/usr/lib/modules-load.d/snd-zg01.conf"
}
